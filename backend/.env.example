# CareerPilot AI Backend Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500
CORS_ALLOWED_ORIGINS=https://app.careerpilot.ai,https://careerpilot.ai

# Database Configuration (TiDB Cloud / MySQL)
TIDB_HOST=your-tidb-host
TIDB_PORT=4000
TIDB_USER=your-tidb-user
TIDB_PASSWORD=your-tidb-password
TIDB_DATABASE=careerpilot
TIDB_ENABLE_SSL=true
TIDB_CA_PATH=
DB_CONNECTION_LIMIT=10

# Session & Security Configuration
SESSION_SECRET=replace-with-secure-long-random-secret
SESSION_COOKIE_NAME=careerpilot.sid
SESSION_MAX_AGE_MS=86400000
SECURE_COOKIE=false

# AI Service Connection
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET=placeholder_secret_key_change_in_production
AI_SERVICE_TIMEOUT_MS=5000
